<Project Sdk="MSTest.Sdk/4.0.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
    <!--
      MSTEST0037 is a stylistic preference between Assert.AreEqual(0, x.Count) and Assert.HasCount(0, x).
      The count form keeps the failure message readable when the collection is not materialised.
    -->
    <NoWarn>$(NoWarn);MSTEST0037</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Layeron.Big3DArray\Layeron.Big3DArray.csproj" />
    <ProjectReference Include="..\Layeron.Plugin.Abstractions\Layeron.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\Layeron.Plugin.Host\Layeron.Plugin.Host.csproj" />
    <!--
      The scripting contract must be in the test's default context: Roslyn loads the compiled script
      there, and the script host plugin binds ScriptGlobals to this one copy. Without the reference it
      would only exist inside the plugin folder, which the default context cannot see.
    -->
    <ProjectReference Include="..\Layeron.Scripting.Abstractions\Layeron.Scripting.Abstractions.csproj" />
    <!--
      The script host is built but not referenced: the tests only need its assembly on disk, because it
      is exercised through the plugin loader exactly as a user's plugin would be.
    -->
    <ProjectReference Include="..\Layeron.Plugins.ScriptHost\Layeron.Plugins.ScriptHost.csproj" ReferenceOutputAssembly="false" />
    <!--
      The 3D plugin is referenced so its extraction and rasterisation maths can be tested directly, in
      addition to being loaded and unloaded as an isolated plugin by AssemblyPluginTests. Its visual
      tree is not exercised here, so the tests stay headless.
    -->
    <ProjectReference Include="..\Layeron.Plugins.Model3D\Layeron.Plugins.Model3D.csproj" />
    <!--
      The threshold plugin is referenced so its algorithm can be tested directly, unit-test style,
      in addition to being loaded and unloaded as an isolated plugin by AssemblyPluginTests.
    -->
    <ProjectReference Include="..\Layeron.Plugins.Threshold\Layeron.Plugins.Threshold.csproj" />
    <!--
      Referenced, not just built: the Python engine's numpy bridge can only be verified against a real
      interpreter, and its internal types are exposed to this assembly. This does add an assembly to the test
      output that is also a plugin, but the tests never scan the output folder for plugins - they load the
      built plugin assemblies by explicit path (TestPaths).
    -->
    <ProjectReference Include="..\Layeron.Plugins.PythonRunner\Layeron.Plugins.PythonRunner.csproj" />
    <!--
      Reference it, not just build it: the ONNX runner's tiling, binder and settings are internal, and there is no
      meaningful way to fake a native inference session - so the tests drive the real thing. The plugin's own
      assembly is also loaded by explicit path in the loader test, so the deployment path is covered too.
    -->
    <ProjectReference Include="..\Layeron.Plugins.OnnxRuntime\Layeron.Plugins.OnnxRuntime.csproj" />
    <!--
      The ONNX runner's published contract. Unlike a plugin, the test assembly is not loaded into a collectible load
      context, so it needs an ordinary copy in its own output - the contract has to come from somewhere, and there is
      no plugins.shared folder next to a test host.
    -->
    <ProjectReference Include="..\Layeron.Plugins.Onnx.Api\Layeron.Plugins.Onnx.Api.csproj" />
    <!--
      Referenced so the agent's option store can be tested directly: what it writes, what it refuses to write,
      and where the key comes from are all decisions that have nothing to do with the network or the UI.
    -->
    <ProjectReference Include="..\Layeron.Plugins.Agent\Layeron.Plugins.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The ONNX panel is a ReactiveUI view model, and the plugin deliberately excludes ReactiveUI's runtime assets
      (the host supplies them). A test host has no host stack to borrow from, so the runtime is referenced here at the
      same version Layeron.App resolves - otherwise the panel's own type cannot be loaded at all.
    -->
    <PackageReference Include="ReactiveUI" Version="24.2.0" />
  </ItemGroup>

</Project>
