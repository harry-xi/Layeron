<Project Sdk="MSTest.Sdk/4.0.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
    <!--
      MSTEST0037 is a stylistic preference between Assert.AreEqual(0, x.Count) and Assert.HasCount(0, x).
      The count form keeps the failure message readable when the collection is not materialised.
    -->
    <NoWarn>$(NoWarn);MSTEST0037</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Layeron.Big3DArray\Layeron.Big3DArray.csproj" />
    <ProjectReference Include="..\Layeron.Plugin.Abstractions\Layeron.Plugin.Abstractions.csproj" />
    <ProjectReference Include="..\Layeron.Plugin.Host\Layeron.Plugin.Host.csproj" />
    <!--
      The scripting contract must be in the test's default context: Roslyn loads the compiled script
      there, and the script host plugin binds ScriptGlobals to this one copy. Without the reference it
      would only exist inside the plugin folder, which the default context cannot see.
    -->
    <ProjectReference Include="..\Layeron.Scripting.Abstractions\Layeron.Scripting.Abstractions.csproj" />
    <!--
      The script host is built but not referenced: the tests only need its assembly on disk, because it
      is exercised through the plugin loader exactly as a user's plugin would be.
    -->
    <ProjectReference Include="..\Layeron.Plugins.ScriptHost\Layeron.Plugins.ScriptHost.csproj" ReferenceOutputAssembly="false" />
    <!--
      The 3D plugin is referenced so its extraction and rasterisation maths can be tested directly, in
      addition to being loaded and unloaded as an isolated plugin by AssemblyPluginTests. Its visual
      tree is not exercised here, so the tests stay headless.
    -->
    <ProjectReference Include="..\Layeron.Plugins.Model3D\Layeron.Plugins.Model3D.csproj" />
    <!--
      The threshold plugin is referenced so its algorithm can be tested directly, unit-test style,
      in addition to being loaded and unloaded as an isolated plugin by AssemblyPluginTests.
    -->
    <ProjectReference Include="..\Layeron.Plugins.Threshold\Layeron.Plugins.Threshold.csproj" />
  </ItemGroup>

</Project>
