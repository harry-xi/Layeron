<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Layeron.Plugins.Agent</AssemblyName>
    <!-- 视图与聊天面板声明在 XAML 中，因此需要运行 Avalonia 的 XAML 编译器。 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      智能体的私有用依赖必须落在插件自己旁边。Agent Framework 和 OpenAI SDK 都不是宿主携带的程序集，
      插件加载上下文只能从本目录解析；不复制的话插件目录里只有插件本身，第一次发送就会以找不到程序集失败。
      宿主持有的那些（Avalonia、ReactiveUI、Microsoft.Extensions.*）仍然由宿主提供，不会被复制——见
      HostCarriedAssemblies。
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- ImageSharp 的构建目标需要与宿主相同的许可证文件；变量由开发环境提供。 -->
    <SixLaborsLicenseFile>$(SIXLABORS_LICENSE_FILE)</SixLaborsLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LayeronPluginId" Value="layeron.agent" />
    <AssemblyMetadata Include="LayeronPluginName" Value="Agent" />
    <AssemblyMetadata Include="LayeronPluginVersion" Value="1.0.0" />
    <AssemblyMetadata Include="LayeronPluginDescription" Value="Chat panel for an AI agent, with attachments and a settings page." />
    <AssemblyMetadata Include="LayeronPluginApiVersion" Value="1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Agent Framework 与 OpenAI SDK：插件的私有用依赖，运行时随插件目录部署，
      由插件的加载上下文解析（CopyLocalLockFileAssemblies 见上）。
    -->
    <PackageReference Include="Microsoft.Agents.AI" Version="1.25.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.25.0" />
    <!--
      ImageSharp 只用于把视觉模型不接受的位图格式（BMP、TIFF 等）转换成 PNG。
      宿主也引用同一版本；插件保留运行资产，使测试宿主和独立加载都不依赖宿主是否携带它。
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      契约只编译期引用：运行时必须用宿主的那一份，否则插件会看到第二个 IPlugin 类型。
      这样插件目录里也不会出现宿主程序集的副本。
    -->
    <ProjectReference Include="..\Layeron.Big3DArray\Layeron.Big3DArray.csproj" Private="false" />
    <ProjectReference Include="..\Layeron.Plugin.Abstractions\Layeron.Plugin.Abstractions.csproj" Private="false" />
    <!-- 附件选择要走宿主的文件对话框：脚本宿主服务正是宿主已有的那个 UI 缝隙。 -->
    <ProjectReference Include="..\Layeron.Scripting.Abstractions\Layeron.Scripting.Abstractions.csproj" Private="false" />

    <!--
      另一个插件的契约：智能体要把 Python 当作工具调用，靠的就是这一份共享程序集。
      Private="false" 是这里唯一重要的事——运行时它由宿主的共享加载上下文提供（plugins.shared 目录），
      而不是随本插件复制一份。复制一份就会得到"同名但不同"的 IPythonRunnerService，扩展点里取到的
      实例将无法转换，而且不会有任何报错。详见 docs/plugin/shared-contracts.md。
    -->
    <ProjectReference Include="..\Layeron.Plugins.PythonRunner.Api\Layeron.Plugins.PythonRunner.Api.csproj" Private="false" />

    <!-- UI 插件对宿主的 Avalonia 声明视图；排除运行时资产，插件不会附上第二份副本。 -->
    <PackageReference Include="Avalonia" Version="12.1.3" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <!-- 与宿主 App 相同的 MVVM 栈（ReactiveUI），在运行时共享。版本需与 Layeron.App 一致。 -->
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!--
      从流更新到面板事件的映射是内部实现，不是契约；测试直接驱动它，而不是把这段逻辑公开出来。
      这里只覆盖不依赖 Avalonia 的那一半——面板那一半需要真正的 UI 栈。
    -->
    <InternalsVisibleTo Include="Layeron.Plugin.Test" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GetDocs 通过清单资源名读取 Markdown。SDK 默认只嵌入 .resx，普通文件必须显式声明；
      LogicalName 把文件放到 ChatSkills 约定的前缀下，而不是默认的 Resource.Docs.xxx 路径。
    -->
    <EmbeddedResource Include="Resource\Docs\**\*.md">
      <LogicalName>Layeron.Plugins.Agent.Docs.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
