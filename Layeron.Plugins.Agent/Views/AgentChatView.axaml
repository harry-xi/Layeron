<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Layeron.Plugins.Agent"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="640"
             x:Class="Layeron.Plugins.Agent.AgentChatView"
             x:DataType="local:AgentChatViewModel">
  <UserControl.Resources>
    <!--
      颜色在这里声明一次，而不是让控件去继承：气泡是深色的，主题的前景色对它一无所知，
      任何没写颜色的控件都会拿到主题的黑字，在深色气泡上等于看不见。
    -->
    <SolidColorBrush x:Key="ChatAnswerBrush" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="ChatMutedBrush" Color="#A8A8A8"/>
    <SolidColorBrush x:Key="ChatFailedBrush" Color="#E08A8A"/>
    <SolidColorBrush x:Key="ChatRaisedBrush" Color="#1C1C1C"/>
    <FontFamily x:Key="ChatMonoFont">Cascadia Code, Consolas, Menlo, Monospace</FontFamily>
    <!-- 气泡最大宽度按面板宽度算，见 BubbleWidthConverter。 -->
    <local:BubbleWidthConverter x:Key="BubbleWidth"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <!--
      折叠头（思考 / 调用工具）必须自己定色：Expander 的模板既不设 Foreground 也不给展开箭头定色，
      两者都走主题的 ThemeForegroundBrush——在深色气泡上就是黑字配黑箭头，等于没有折叠头。
      这些样式限定在 chatFold 上，别的 Expander 不受影响。
    -->
    <Style Selector="Expander.chatFold">
      <Setter Property="Foreground" Value="{StaticResource ChatMutedBrush}"/>
      <Setter Property="Background" Value="{StaticResource ChatRaisedBrush}"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="6,2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Expander.chatFold /template/ Path">
      <Setter Property="Fill" Value="{StaticResource ChatMutedBrush}"/>
    </Style>
    <Style Selector="Expander.chatFold:pointerover /template/ Border">
      <Setter Property="BorderBrush" Value="{StaticResource ChatMutedBrush}"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!--
      顶部工具栏只留对话级操作（取消、清空）：发送按钮已经下移到输入框旁边，和常见聊天软件一致，
      这两个动作改变的是整轮对话的状态，所以留在上面而不是挤在发送旁边。
    -->
    <Border DockPanel.Dock="Top" Background="LightGray" Padding="6,4">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="取消" Command="{Binding CancelCommand}" IsEnabled="{Binding IsBusy}"/>
        <Button Content="清空对话" Command="{Binding ClearCommand}" IsEnabled="{Binding HasMessages}"/>
        <ProgressBar Width="80" Height="4" VerticalAlignment="Center"
                     IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="6">
      <StackPanel Spacing="4">
        <!-- 待发附件：换行排布，附件多时不会把输入框挤出窗口。 -->
        <DockPanel IsVisible="{Binding HasAttachments}">
          <Button DockPanel.Dock="Right" Content="全部移除" FontSize="11" Padding="6,1"
                  VerticalAlignment="Top" Margin="6,0,0,0"
                  Command="{Binding RemoveAllAttachmentsCommand}"/>
          <ItemsControl ItemsSource="{Binding Attachments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="local:AgentAttachment">
                <Border Background="#20808080" CornerRadius="10" Padding="8,2" Margin="0,0,6,4"
                        ToolTip.Tip="{Binding Tooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding DisplayText}" FontSize="11" VerticalAlignment="Center"
                               MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                    <Button Content="✕" FontSize="10" Padding="4,0" Background="Transparent"
                            BorderThickness="0" VerticalAlignment="Center"
                            Command="{Binding RemoveCommand}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <TextBox Text="{Binding Draft, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="56" MaxHeight="140"
                 PlaceholderText="{Binding InputHint}"/>

        <!--
          发送按钮在输入框正下方、右对齐：写完就往下按，是聊天软件的常规动线。
          AI 工作时同一个按钮变成「指导」，把输入送进正在运行的一轮，而不是另起一轮。
          状态文字与它同一行左端，因为"现在在干什么"正是按下按钮前后要看的东西。
        -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11" Opacity="0.7"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <Button Grid.Column="1" Content="{Binding SendLabel}" MinWidth="72"
                  Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"/>
        </Grid>

        <!--
          添加附件只有两条不依赖插件类型的入口：从磁盘选，或手填路径。具体路径怎么来
          （拖放、历史记录、某种外部对象）由调用方决定，面板只负责把它变成一条附件。
        -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
          <Button Grid.Column="0" Content="添加文件…" Command="{Binding BrowseAttachmentCommand}"/>
          <TextBox Grid.Column="1" Text="{Binding ExternalPath, Mode=TwoWay}"
                   PlaceholderText="或粘贴一个文件路径"/>
          <Button Grid.Column="2" Content="添加路径" Command="{Binding AddPathAttachmentCommand}"/>
          <Button Grid.Column="3" Content="存为文本附件" Command="{Binding AddTextAttachmentCommand}"
                  ToolTip.Tip="把输入框里的内容变成一个文本附件"/>
        </Grid>
      </StackPanel>
    </Border>

    <!--
      消息列表。气泡按角色左右分开：谁说的要一眼可见，而不是靠读标题。
    -->
    <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}" Margin="6">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="local:ChatMessage">
            <StackPanel HorizontalAlignment="{Binding BubbleAlignment}" Margin="0,0,0,10">
              <TextBlock Text="{Binding Header}" FontSize="10" Opacity="0.55" Margin="4,0,4,2"
                         HorizontalAlignment="{Binding BubbleAlignment}"/>
              <!--
                宽度按面板宽度的 80% 走：窗口拉宽时气泡跟着变宽，但仍留出一条明显的空白，
                左右对齐的气泡才仍然分得清是谁说的。
              -->
              <Border Background="{Binding BubbleBrush}" CornerRadius="10" Padding="10,6"
                      MaxWidth="{Binding $parent[ScrollViewer].Bounds.Width, Converter={StaticResource BubbleWidth}}">
                <StackPanel Spacing="4">
                  <!--
                    用户的正文与 Agent 的回复只会有其中一种，所以这里是二选一而不是并列：
                    用户消息是一段普通正文，Agent 回复则是一串按产生顺序排列的部分
                    （思考、工具调用、回答），顺序本身就是它要表达的东西。
                  -->
                  <TextBlock Text="{Binding Body}" TextWrapping="Wrap"
                             Foreground="{Binding BodyBrush}"
                             IsVisible="{Binding HasBody}"/>
                  <ItemsControl ItemsSource="{Binding Parts}" IsVisible="{Binding HasParts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="4"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                      <DataTemplate DataType="local:ChatTextPart">
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap"
                                   Foreground="{Binding BodyBrush}"/>
                      </DataTemplate>

                      <!--
                        思考块默认折叠：思考很长，展开会把对话挤没，而它只是回答的来路，不是回答。
                        折叠头带上前五个字的摘要，所以两条思路不用展开也分得清；底色比气泡更深，
                        折起来时它就是一条可以点开的横条。
                      -->
                      <DataTemplate DataType="local:ChatReasoningPart">
                        <Expander Classes="chatFold" Header="{Binding Header}"
                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                          <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="11"
                                     Margin="0,2,0,0"
                                     Foreground="{Binding BodyBrush}"/>
                        </Expander>
                      </DataTemplate>

                      <!--
                        一次工具调用：工具名 + 参数 + 结果。调用与结果合成一行，是因为它们本来就是
                        一回事：没有结果的调用就是"还在跑"，拆成两行反而看不出配对关系。
                        默认折叠，所以折叠头必须自己说清状态（调用中／已返回／有失败），
                        否则用户要点开才知道刚才发生了什么。
                      -->
                      <DataTemplate DataType="local:ChatToolCallPart">
                        <Expander Classes="chatFold" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                          <Expander.Header>
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                         Foreground="{Binding StatusBrush}" FontSize="10"
                                         Margin="6,0,0,0"/>
                              <TextBlock Text="{Binding Header}" FontSize="11"
                                         Foreground="{StaticResource ChatMutedBrush}"/>
                            </DockPanel>
                          </Expander.Header>
                          <ItemsControl ItemsSource="{Binding Calls}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="local:ChatToolCall">
                                <StackPanel Spacing="1" Margin="0,0,0,4">
                                  <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                               Foreground="{Binding StatusBrush}" FontSize="10"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource ChatAnswerBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                  </DockPanel>
                                  <TextBlock Text="{Binding ArgumentsText}" FontSize="11"
                                             TextWrapping="Wrap"
                                             Foreground="{StaticResource ChatMutedBrush}"
                                             FontFamily="{StaticResource ChatMonoFont}"/>
                                  <!--
                                    需要确认的调用在这里给出决定：确认按钮就在参数下方，用户不必先看懂
                                    工具名再去找另一个地方回答。决定之后这两个按钮消失，状态行改说结果。
                                  -->
                                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                                              IsVisible="{Binding NeedsApproval}">
                                    <Button Content="允许" Command="{Binding ApproveCommand}"
                                            FontSize="11" Padding="8,1"
                                            ToolTip.Tip="批准后执行这个工具"/>
                                    <Button Content="拒绝" Command="{Binding RejectCommand}"
                                            FontSize="11" Padding="8,1"
                                            ToolTip.Tip="拒绝后不会执行这个工具"/>
                                  </StackPanel>
                                  <!-- 结果只在真的到了之后才占一行，未返回的调用就是这样一眼可辨的。 -->
                                  <TextBlock Text="{Binding ResultText}" IsVisible="{Binding HasResult}"
                                             FontSize="11" TextWrapping="Wrap"
                                             Foreground="{Binding ResultBrush}"
                                             FontFamily="{StaticResource ChatMonoFont}"/>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Expander>
                      </DataTemplate>
                    </ItemsControl.DataTemplates>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="local:AgentAttachment">
                        <!--
                          附件行只说明"引用了什么"：气泡背景已经区分了角色，这里再挑颜色只会让一条
                          消息里的两段文字看起来属于不同的人。颜色仍然跟着消息走，而不是留给主题——
                          在深色气泡里继承到的黑字和看不见没有区别。
                        -->
                        <TextBlock Text="{Binding TranscriptText}" FontSize="11"
                                   Foreground="{Binding $parent[ItemsControl].DataContext.BodyBrush}"
                                   TextWrapping="Wrap"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
