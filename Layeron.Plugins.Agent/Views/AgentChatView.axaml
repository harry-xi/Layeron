<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Layeron.Plugins.Agent"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="640"
             x:Class="Layeron.Plugins.Agent.AgentChatView"
             x:DataType="local:AgentChatViewModel">
  <UserControl.Resources>
    <FontFamily x:Key="ChatMonoFont">Cascadia Code, Consolas, Menlo, Monospace</FontFamily>
  </UserControl.Resources>

  <UserControl.Styles>
    <!--
      对话框名称平时就是一行字：边框和背景都透明，只有获得焦点时才浮出输入框。
      提交时机见 AgentChatView.axaml.cs。
    -->
    <Style Selector="TextBox.chatTitle">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox.chatTitle:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}"/>
      <Setter Property="Background" Value="{DynamicResource ThemeControlLowBrush}"/>
    </Style>

    <!--
      消息不再画成气泡：每一条是一条带角色色条的记录，正文占满面板宽度。
      颜色全部来自主题，浅色和深色切换时不需要另一套聊天配色。
    -->
    <Style Selector="Grid.chatMessage">
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style Selector="Border.chatRail">
      <Setter Property="Width" Value="3"/>
      <Setter Property="CornerRadius" Value="1.5"/>
      <Setter Property="Background" Value="{DynamicResource ThemeBorderMidBrush}"/>
    </Style>
    <Style Selector="Grid.chatMessage.user Border.chatRail">
      <Setter Property="Background" Value="{DynamicResource LayeronAccentBrush}"/>
    </Style>
    <Style Selector="Grid.chatMessage.system Border.chatRail">
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="TextBlock.chatRole">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>
    <Style Selector="Grid.chatMessage.user TextBlock.chatRole">
      <Setter Property="Foreground" Value="{DynamicResource LayeronAccentBrush}"/>
    </Style>
    <Style Selector="Grid.chatMessage.system TextBlock.chatRole">
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}"/>
    </Style>

    <Style Selector="TextBlock.chatTime">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}"/>
      <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style Selector="TextBlock.chatBody">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
    </Style>
    <Style Selector="Grid.chatMessage.system TextBlock.chatBody">
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}"/>
      <Setter Property="FontStyle" Value="Italic"/>
    </Style>

    <Style Selector="TextBlock.chatStatus">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}"/>
    </Style>
    <Style Selector="TextBlock.chatStatus.pending">
      <Setter Property="Foreground" Value="{DynamicResource LayeronAccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.chatStatus.failed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <Style Selector="TextBlock.chatMono">
      <Setter Property="FontFamily" Value="{StaticResource ChatMonoFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}"/>
    </Style>
    <Style Selector="TextBlock.chatMono.failed">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <!--
      思考 / 工具调用仍是可折叠的次要内容，但改成主题表面的圆角卡片，而不是更暗的气泡内层。
    -->
    <Style Selector="Expander.chatFold">
      <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}"/>
      <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="Expander.chatFold /template/ Path">
      <Setter Property="Fill" Value="{DynamicResource ThemeForegroundLowBrush}"/>
    </Style>
    <Style Selector="Expander.chatFold:pointerover /template/ Border">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}"/>
    </Style>

    <Style Selector="Border.chatChip">
      <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,1"/>
    </Style>

    <Style Selector="TextBox.chatInput">
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!--
      顶部只保留对话级操作（历史、取消、新建）：它们改变的是整轮对话，不跟输入框抢位置。
    -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ThemeControlMidBrush}"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,5">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <Border Grid.Column="0" Width="20" Height="20" CornerRadius="6"
                Background="{DynamicResource LayeronAccentBrush}">
          <TextBlock Text="A" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource LayeronAccentTextBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBox Grid.Column="1" Classes="chatTitle"
                 Text="{Binding ConversationTitleDraft, Mode=TwoWay}"
                 LostFocus="TitleBox_LostFocus"
                 KeyDown="TitleBox_KeyDown"
                 VerticalAlignment="Center"
                 ToolTip.Tip="点击修改对话名称；Enter 保存，Esc 取消"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="ghost compact" Content="历史" Command="{Binding OpenHistoryCommand}"
                  ToolTip.Tip="打开独立的「Agent 历史」窗口"/>
          <Button Classes="ghost compact" Content="取消" Command="{Binding CancelCommand}"
                  IsEnabled="{Binding IsBusy}"/>
          <Button Classes="compact" Content="新建对话" Command="{Binding NewConversationCommand}"
                  ToolTip.Tip="开始一场新对话；当前对话仍保留在历史中"/>
          <ProgressBar Width="56" Height="4" VerticalAlignment="Center"
                       IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!--
      输入区：附件在上，正文居中，状态与发送按钮同一行。底色比正文略深，形成一条稳定的输入带。
    -->
    <Border DockPanel.Dock="Bottom" Padding="8,6"
            Background="{DynamicResource ThemeControlMidBrush}"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Spacing="6">
        <DockPanel IsVisible="{Binding HasAttachments}">
          <Button DockPanel.Dock="Right" Classes="ghost compact" Content="全部移除"
                  VerticalAlignment="Top" Margin="6,0,0,0"
                  Command="{Binding RemoveAllAttachmentsCommand}"/>
          <ItemsControl ItemsSource="{Binding Attachments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="local:AgentAttachment">
                <Border Classes="chatChip" Margin="0,0,4,4" ToolTip.Tip="{Binding Tooltip}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding DisplayText}" FontSize="10" VerticalAlignment="Center"
                               MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                    <Button Classes="ghost" Content="✕" FontSize="10" Width="16" Height="16"
                            MinWidth="0" MinHeight="0" Padding="0" VerticalAlignment="Center"
                            Command="{Binding RemoveCommand}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>

        <TextBox Classes="chatInput"
                 Text="{Binding Draft, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="60" MaxHeight="150"
                 PlaceholderText="{Binding InputHint}"/>

        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11" Opacity="0.65"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <!--
            与 Agent 设置页中的开关是同一个存储值：放在状态行旁边，是因为它决定下一次工具调用
            是否停下来问人，属于运行时的选择，不该逼用户离开对话去设置窗口。
          -->
          <CheckBox Grid.Column="1" Content="自动通过" FontSize="11"
                    IsChecked="{Binding AutoApproveTools, Mode=TwoWay}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="开启后，写文件、删除文件、执行 Python 代码或脚本不再逐次确认；与 Agent 设置页中的开关相同"/>
          <Button Grid.Column="2" Classes="accent" Content="{Binding SendLabel}" MinWidth="76"
                  Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}"/>
        </Grid>

        <!--
          添加附件只有两条不依赖插件类型的入口：从磁盘选，或手填路径。
        -->
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
          <Button Grid.Column="0" Classes="ghost compact" Content="添加文件…"
                  Command="{Binding BrowseAttachmentCommand}"/>
          <TextBox Grid.Column="1" Text="{Binding ExternalPath, Mode=TwoWay}"
                   PlaceholderText="或粘贴一个文件路径"/>
          <Button Grid.Column="2" Classes="ghost compact" Content="添加路径"
                  Command="{Binding AddPathAttachmentCommand}"/>
          <Button Grid.Column="3" Classes="ghost compact" Content="存为文本附件"
                  Command="{Binding AddTextAttachmentCommand}"
                  ToolTip.Tip="把输入框里的内容变成一个文本附件"/>
        </Grid>
      </StackPanel>
    </Border>

    <!--
      对话记录：扁平列表，不再使用左右气泡。角色由左侧色条、名称和时间表达，
      正文使用主题前景色，思考/工具调用折叠成主题表面的小卡片。
    -->
    <Panel>
      <ScrollViewer x:Name="MessageScroller" VerticalScrollBarVisibility="Auto"
                    Padding="10,10,10,2">
        <ItemsControl ItemsSource="{Binding Messages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="local:ChatMessage">
              <Grid Classes="chatMessage"
                    Classes.user="{Binding IsUser}"
                    Classes.assistant="{Binding IsAssistant}"
                    Classes.system="{Binding IsSystem}"
                    ColumnDefinitions="3,*" ColumnSpacing="10">
                <Border Grid.Column="0" Classes="chatRail" Margin="0,2,0,2"/>

                <StackPanel Grid.Column="1" Spacing="6">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock Grid.Column="0" Classes="chatRole" Text="{Binding RoleLabel}"
                               VerticalAlignment="Center"/>
                    <Border Grid.Column="1" IsVisible="{Binding IsGuidance}"
                            Background="{DynamicResource LayeronAccentSubtleBrush}"
                            CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                      <TextBlock Text="指导" FontSize="9"
                                 Foreground="{DynamicResource LayeronAccentBrush}"/>
                    </Border>
                    <TextBlock Grid.Column="3" Classes="chatTime" Text="{Binding TimeText}"
                               VerticalAlignment="Center"/>
                  </Grid>

                  <!--
                    用户/系统消息是一段正文；Agent 回复是一串按产生顺序排列的部分
                    （思考、工具调用、回答）。
                  -->
                  <TextBlock Classes="chatBody" Text="{Binding Body}" IsVisible="{Binding HasBody}"/>

                  <ItemsControl ItemsSource="{Binding Parts}" IsVisible="{Binding HasParts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="6"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                      <DataTemplate DataType="local:ChatTextPart">
                        <TextBlock Classes="chatBody" Text="{Binding Body}"/>
                      </DataTemplate>

                      <!-- 思考：默认折叠，折叠头带摘要。 -->
                      <DataTemplate DataType="local:ChatReasoningPart">
                        <Expander Classes="chatFold" Header="{Binding Header}"
                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                          <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="11"
                                     LineHeight="18" Margin="0,2,0,0"
                                     Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </Expander>
                      </DataTemplate>

                      <!-- 工具调用：调用与结果合成一行，状态在折叠头上就能看见。 -->
                      <DataTemplate DataType="local:ChatToolCallPart">
                        <Expander Classes="chatFold" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                          <Expander.Header>
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}"
                                         Classes="chatStatus"
                                         Classes.pending="{Binding IsPending}"
                                         Classes.failed="{Binding IsFailed}"
                                         Margin="6,0,0,0"/>
                              <TextBlock Text="{Binding Header}" FontSize="11"
                                         Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                            </DockPanel>
                          </Expander.Header>
                          <ItemsControl ItemsSource="{Binding Calls}" Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="local:ChatToolCall">
                                <StackPanel Spacing="3" Margin="0,0,0,6">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource ThemeForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                               Classes="chatStatus"
                                               Classes.pending="{Binding IsPending}"
                                               Classes.failed="{Binding IsFailed}"/>
                                  </Grid>
                                  <TextBlock Text="{Binding ArgumentsText}" Classes="chatMono"/>
                                  <!--
                                    需要确认的调用就在这里给出决定：按钮挨着参数，用户不必
                                    先看懂工具名再去别处回答。决定后按钮消失，状态行改说结果。
                                  -->
                                  <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0"
                                              IsVisible="{Binding NeedsApproval}">
                                    <Button Classes="accent compact" Content="允许"
                                            Command="{Binding ApproveCommand}"
                                            ToolTip.Tip="批准后执行这个工具"/>
                                    <Button Classes="danger compact" Content="拒绝"
                                            Command="{Binding RejectCommand}"
                                            ToolTip.Tip="拒绝后不会执行这个工具"/>
                                  </StackPanel>
                                  <TextBlock Text="{Binding ResultText}" IsVisible="{Binding HasResult}"
                                             Classes="chatMono"
                                             Classes.failed="{Binding IsFailed}"/>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Expander>
                      </DataTemplate>
                    </ItemsControl.DataTemplates>
                  </ItemsControl>

                  <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="local:AgentAttachment">
                        <Border Classes="chatChip" Margin="0,0,4,4" ToolTip.Tip="{Binding Tooltip}">
                          <TextBlock Text="{Binding TranscriptText}" FontSize="10"
                                     MaxWidth="260" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource ThemeForegroundLowBrush}"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- 空状态说明下一步，而不是留一块像加载失败的空白。 -->
      <StackPanel IsVisible="{Binding !HasMessages}" IsHitTestVisible="False"
                  VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
        <Border Width="40" Height="40" CornerRadius="10"
                Background="{DynamicResource LayeronAccentSubtleBrush}"
                HorizontalAlignment="Center">
          <TextBlock Text="A" FontSize="17" FontWeight="Bold"
                     Foreground="{DynamicResource LayeronAccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="向 Agent 提问" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="可以描述要查看的切片、要执行的操作，或附上一张切片 / 一个文件。"
                   FontSize="11" Opacity="0.6" MaxWidth="280"
                   TextWrapping="Wrap" TextAlignment="Center"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Panel>
  </DockPanel>
</UserControl>
