<Project Sdk="MSTest.Sdk/4.0.2">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseVSTest>true</UseVSTest>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The app is referenced, not its logging file alone: Log.cs lives in the application and that is
      where it should stay. The tests cover the parts that are hard to eyeball - template arity, ring
      eviction order, concurrent writers.
    -->
    <ProjectReference Include="..\Layeron.App\Layeron.App.csproj" />
    <!--
      UI lifecycle tests (a plugin control moving between dock views) need a real layout pass.
      Headless keeps that in-process and off the desktop.
    -->
    <PackageReference Include="Avalonia.Headless" Version="12.2.0" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.2.0" />
  </ItemGroup>

</Project>
