<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Layeron.Plugins.MaskMorphology</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LayeronPluginId" Value="layeron.maskmorphology" />
    <AssemblyMetadata Include="LayeronPluginName" Value="Mask Morphology" />
    <AssemblyMetadata Include="LayeronPluginVersion" Value="1.0.0" />
    <AssemblyMetadata Include="LayeronPluginDescription" Value="Erode, dilate, open, close and copy mask layers with cube, ball or cross structuring elements." />
    <AssemblyMetadata Include="LayeronPluginApiVersion" Value="1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts are compile-time only: the host's copies must be used at runtime. -->
    <ProjectReference Include="..\Layeron.Big3DArray\Layeron.Big3DArray.csproj" Private="false" />
    <ProjectReference Include="..\Layeron.Plugin.Abstractions\Layeron.Plugin.Abstractions.csproj" Private="false" />

    <!-- UI plugins declare views in XAML against the host's Avalonia; runtime assets are excluded. -->
    <PackageReference Include="Avalonia" Version="12.1.3" ExcludeAssets="runtime" />
    <!-- Same MVVM stack as the host App (ReactiveUI), supplied by the host at runtime. -->
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
