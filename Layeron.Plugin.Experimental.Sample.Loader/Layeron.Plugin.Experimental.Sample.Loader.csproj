<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Layeron.Plugin.Experimental.Sample.Loader</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the host contract; the host's copy is used at runtime. -->
    <ProjectReference Include="..\Layeron.Plugin.Experimental\Layeron.Plugin.Experimental.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LayeronExperimentalPluginId" Value="sample.loader" />
    <AssemblyMetadata Include="LayeronExperimentalPluginName" Value="Sample Child Loader" />
    <AssemblyMetadata Include="LayeronExperimentalPluginVersion" Value="1.0.0" />
    <AssemblyMetadata Include="LayeronExperimentalPluginDescription" Value="Application-lifetime loader that publishes two child plugins through a source." />
    <AssemblyMetadata Include="LayeronExperimentalPluginApiVersion" Value="1.0" />
    <AssemblyMetadata Include="LayeronExperimentalPluginLifetime" Value="app" />
  </ItemGroup>

</Project>
