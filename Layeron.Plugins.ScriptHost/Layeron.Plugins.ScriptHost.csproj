<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <!--
      Native and framework-dependent assets must follow the host's RID. Without this a RID-specific
      build (for example -r win-x64) still deploys this plugin's every-platform untimes folder,
      which is what made the Windows package carry macOS/Linux Skia binaries and PDBs.
    -->
    <IsRidAgnostic>false</IsRidAgnostic>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Layeron.Plugins.ScriptHost</AssemblyName>
    <!--
      A plugin is a library, and libraries do not copy their NuGet dependencies to the output folder by
      default. Roslyn is a private dependency that must ship next to the plugin so the plugin's own load
      context can resolve it, so this has to be switched on explicitly.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!--
      The script editor is declared in XAML, so the Avalonia XAML compiler must run for this project.
      Avalonia itself comes from the host and is excluded from the plugin's runtime assets below.
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LayeronPluginId" Value="layeron.scripthost" />
    <AssemblyMetadata Include="LayeronPluginName" Value="C# Script Host" />
    <AssemblyMetadata Include="LayeronPluginVersion" Value="1.0.0" />
    <AssemblyMetadata Include="LayeronPluginDescription" Value="Loads .csx scripts from the scripts folder as plugins and edits them in a dockable editor." />
    <AssemblyMetadata Include="LayeronPluginApiVersion" Value="1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Layeron.Big3DArray\Layeron.Big3DArray.csproj" Private="false" />
    <ProjectReference Include="..\Layeron.Plugin.Abstractions\Layeron.Plugin.Abstractions.csproj" Private="false" />
    <ProjectReference Include="..\Layeron.Scripting.Abstractions\Layeron.Scripting.Abstractions.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Roslyn is a private dependency: it ships inside this plugin's folder and is loaded by the
      plugin's own load context, not by the host. That is exactly why the host only defers the
      framework assemblies it owns.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.12.0" />
    <!-- UI is the host's: compile assets only, so the plugin never ships its own Avalonia. -->
    <PackageReference Include="Avalonia" Version="12.2.0" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" ExcludeAssets="runtime" />
    <!--
      NumSharp reaches this project transitively through the scripting contract, but it is the host stack's
      copy that must win (the script binds to the default context's). Excluded so the plugin folder does not
      ship a second one.
    -->
    <PackageReference Include="NumSharp" Version="0.81.0" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
