<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Layeron.Plugins.Model3D</AssemblyName>
    <!-- Avalonia XAML: enable compiled XAML for the plugin's own view. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The rasteriser writes straight into a locked WriteableBitmap framebuffer, a native address. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="LayeronPluginId" Value="layeron.model3d" />
    <AssemblyMetadata Include="LayeronPluginName" Value="Mask 3D Model" />
    <AssemblyMetadata Include="LayeronPluginVersion" Value="1.0.0" />
    <AssemblyMetadata Include="LayeronPluginDescription" Value="Downsamples a mask layer and shows it as an interactive 3D surface in a document tab." />
    <AssemblyMetadata Include="LayeronPluginApiVersion" Value="1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Contracts are compile-time only: the host's copies must be used at runtime, otherwise the
      plugin would see a second IPlugin type.
    -->
    <ProjectReference Include="..\Layeron.Big3DArray\Layeron.Big3DArray.csproj" Private="false" />
    <ProjectReference Include="..\Layeron.Plugin.Abstractions\Layeron.Plugin.Abstractions.csproj" Private="false" />

    <!--
      UI plugins declare views in XAML against the host's Avalonia; runtime assets are excluded, so the
      plugin binds to the host's Avalonia at runtime instead of shipping a second copy.
    -->
    <PackageReference Include="Avalonia" Version="12.1.3" GeneratePathProperty="true" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The surface extraction and the rasteriser are internal on purpose - they are implementation, not
      contract - so the test project is granted access instead of widening the public surface.
    -->
    <InternalsVisibleTo Include="Layeron.Plugin.Test" />
  </ItemGroup>

</Project>
