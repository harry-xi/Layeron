<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m3d="clr-namespace:Layeron.Plugins.Model3D;assembly=Layeron.Plugins.Model3D"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:Class="Layeron.Plugins.Model3D.Mask3DView">

  <!--
    A toolbar over the 3D viewport. The viewport is an Aura3D view, which renders through the OpenGL
    context Avalonia already provides, so it draws as an ordinary Avalonia visual.
  -->
  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="8" Background="{DynamicResource SukiControlBackground}">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="掩膜" VerticalAlignment="Center" />
        <ComboBox x:Name="LayerBox" Width="150" />

        <TextBlock Text="降采样" VerticalAlignment="Center" />
        <ComboBox x:Name="FactorBox" Width="80" />

        <TextBlock Text="重建方式" VerticalAlignment="Center" />
        <ComboBox x:Name="MethodBox" Width="150" />

        <Button x:Name="GenerateButton" Content="生成模型" />
        <Button x:Name="ImportButton" Content="导入模型…" />
        <Button x:Name="ExportButton" Content="导出模型…" IsEnabled="False" />
        <ProgressBar x:Name="Progress" Width="90" IsIndeterminate="True" IsVisible="False" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="NoWrap" />
      </StackPanel>
    </Border>

    <m3d:Mask3DViewport Grid.Row="1" x:Name="Viewport" />

  </Grid>
</UserControl>
