<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m3d="clr-namespace:Layeron.Plugins.Model3D;assembly=Layeron.Plugins.Model3D"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:Class="Layeron.Plugins.Model3D.Mask3DView">

  <!--
    The document is only the 3D view. Creation, import and the model list live in the "3D 模型" tool
    panel; this tab renders whatever that panel's model manager holds.
  -->
  <Grid>

    <m3d:Mask3DViewport x:Name="Viewport" />

    <Border x:Name="EmptyHint"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="16,12" CornerRadius="6"
            Background="{DynamicResource LayeronSurfaceRaisedBrush}"
            IsHitTestVisible="False">
      <StackPanel Spacing="4">
        <TextBlock Text="没有模型" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Text="在“3D 模型”面板中生成或导入模型。" FontSize="12" Opacity="0.7"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
