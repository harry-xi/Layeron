<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Layeron.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="400"
             x:Class="Layeron.App.Views.MaskManagerView"
             x:DataType="vm:MaskManagerViewModel">

    <Design.DataContext>
        <vm:MaskManagerViewModel/>
    </Design.DataContext>

    <Border Background="{DynamicResource SukiCardBackground}"
            CornerRadius="8"
            Margin="8">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Button Content="Add" Command="{Binding AddMaskCommand}"/>
                <Button Content="Load" Command="{Binding LoadMaskCommand}"/>
                <TextBlock Text="{Binding LayersCountText}"
                           VerticalAlignment="Center"
                           FontSize="12"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="MaskList"
                         ItemsSource="{Binding Masks}"
                         SelectedItem="{Binding ActiveMask, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SukiControlBackground}"
                                    CornerRadius="6"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                <StackPanel Spacing="6">
                                    <DockPanel>
                                        <Button x:Name="ColorButton"
                                                DockPanel.Dock="Left"
                                                Width="32" Height="28"
                                                CornerRadius="4"
                                                Padding="0"
                                                Margin="0,0,8,0"
                                                HorizontalContentAlignment="Center">
                                            <Button.Background>
                                                <SolidColorBrush Color="{Binding Color}"/>
                                            </Button.Background>
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorView Color="{Binding Color, Mode=TwoWay}"
                                                           IsAlphaVisible="True"
                                                           IsAlphaEnabled="True"/>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <CheckBox DockPanel.Dock="Right"
                                                  Content="Show"
                                                  IsChecked="{Binding IsVisible}"
                                                  VerticalAlignment="Center"
                                                  Margin="4,0,0,0"/>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding AlphaPercent}"
                                                   FontSize="11"
                                                   Opacity="0.75"
                                                   VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Name, Mode=TwoWay}"
                                                 VerticalContentAlignment="Center"/>
                                    </DockPanel>

                                    <DockPanel>
                                        <Button Content="Remove"
                                                Command="{Binding DataContext.RemoveMaskCommand, ElementName=MaskList}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Left"/>
                                        <Button Content="Save"
                                                Command="{Binding DataContext.SaveMaskCommand, ElementName=MaskList}"
                                                CommandParameter="{Binding}"
                                                DockPanel.Dock="Right"
                                                HorizontalAlignment="Right"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>