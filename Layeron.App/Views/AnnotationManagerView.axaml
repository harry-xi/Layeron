<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Layeron.App.ViewModels"
             xmlns:models="using:Layeron.App.Models"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="520"
             x:Class="Layeron.App.Views.AnnotationManagerView"
             x:Name="AnnotationManagerRoot"
             x:DataType="vm:AnnotationManagerViewModel">

    <Design.DataContext>
        <vm:AnnotationManagerViewModel/>
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBox.compact">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="CheckBox.compact">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="5,0,0,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.mini">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="ToggleButton.mini">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Small toggle that carries a glyph and its own state, e.g. the layer expander or "T". -->
        <Style Selector="ToggleButton.chip">
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Equal-width segments: the whole tool picker stays on one line. -->
        <Style Selector="ToggleButton.segment">
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="MinWidth" Value="22"/>
            <Setter Property="MinHeight" Value="22"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderHighBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource LayeronAccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource LayeronCardBrush}"
            BorderBrush="{DynamicResource LayeronCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Margin="4">
        <DockPanel>
            <!-- Header and tool picker share one raised strip, so the list starts immediately below them. -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource LayeronSurfaceRaisedBrush}"
                    BorderBrush="{DynamicResource LayeronCardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="7,7,0,0"
                    Padding="6,5">
                <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
                        <Button Classes="accent compact"
                                Content="Add Layer"
                                ToolTip.Tip="Create an annotation layer"
                                Command="{Binding AddLayerCommand}"/>
                        <Button Grid.Column="1"
                                Classes="compact"
                                Content="Load"
                                ToolTip.Tip="Load one or more .la.json annotation layers"
                                Command="{Binding LoadLayerCommand}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding LayersCountText}"
                                   FontSize="11"
                                   Opacity="0.65"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="2">
                        <ToggleButton Grid.Column="0"
                                      Classes="segment"
                                      Content="None"
                                      IsChecked="{Binding IsToolNone, Mode=TwoWay}"/>
                        <ToggleButton Grid.Column="1"
                                      Classes="segment"
                                      Content="Point"
                                      IsChecked="{Binding IsToolPoint, Mode=TwoWay}"/>
                        <ToggleButton Grid.Column="2"
                                      Classes="segment"
                                      Content="Line"
                                      IsChecked="{Binding IsToolLine, Mode=TwoWay}"/>
                        <ToggleButton Grid.Column="3"
                                      Classes="segment"
                                      Content="Polygon"
                                      IsChecked="{Binding IsToolPolygon, Mode=TwoWay}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="{Binding InteractionHint}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding InteractionHint}"/>
                        <!-- Only meaningful while a multi-click shape is in progress. -->
                        <Button Grid.Column="1"
                                Classes="compact"
                                Content="Cancel"
                                ToolTip.Tip="Discard the shape being drawn"
                                IsVisible="{Binding HasPending}"
                                Command="{Binding CancelPendingCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Panel>
                <ListBox x:Name="LayerList"
                         ItemsSource="{Binding Layers}"
                         SelectedItem="{Binding ActiveLayer, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="6"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerTheme>
                        <ControlTheme TargetType="ListBoxItem"
                                      BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Background" Value="{DynamicResource LayeronSurfaceRaisedBrush}"/>
                            <Setter Property="CornerRadius" Value="6"/>
                            <!--
                                Keep the border width constant in every state. The selected/focused style
                                in the base theme switches it on, and without a reserved 1px the whole row
                                would shrink when the item gained focus.
                            -->
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Padding" Value="5"/>
                            <Setter Property="Margin" Value="0,0,0,4"/>
                            <Setter Property="MinHeight" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </ControlTheme>
                    </ListBox.ItemContainerTheme>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:AnnotationLayer">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Button Grid.Column="0"
                                            Classes="swatch"
                                            ToolTip.Tip="Layer colour and transparency">
                                        <Button.Background>
                                            <SolidColorBrush Color="{Binding Color}"/>
                                        </Button.Background>
                                        <Button.Flyout>
                                            <Flyout>
                                                <ColorView Color="{Binding Color, Mode=TwoWay}"
                                                           IsAlphaVisible="True"
                                                           IsAlphaEnabled="True"/>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <TextBox Grid.Column="1"
                                             Classes="compact"
                                             Text="{Binding Name, Mode=TwoWay}"
                                             ToolTip.Tip="Layer name"/>

                                    <!-- Count and expander are one control: the row uses its width for the name. -->
                                    <ToggleButton Grid.Column="2"
                                                  Classes="chip"
                                                  IsChecked="{Binding IsAnnotationsExpanded, Mode=TwoWay}"
                                                  ToolTip.Tip="Show or hide this layer's annotations">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <TextBlock Text="{Binding AnnotationCount}" FontSize="11"/>
                                            <TextBlock Text="{Binding ExpandGlyph}" FontSize="11"/>
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
                                      ColumnSpacing="5">
                                    <CheckBox Grid.Column="0"
                                              Classes="compact"
                                              Content="Show"
                                              IsChecked="{Binding IsVisible}"
                                              ToolTip.Tip="Draw this layer on the slice images"/>
                                    <ToggleButton Grid.Column="1"
                                                  Classes="chip"
                                                  Content="T"
                                                  IsChecked="{Binding ShowLabels, Mode=TwoWay}"
                                                  ToolTip.Tip="Draw this layer's labels on the slice images"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding AlphaPercent}"
                                               Width="32"
                                               TextAlignment="Right"
                                               FontSize="11"
                                               Opacity="0.65"
                                               VerticalAlignment="Center"
                                               ToolTip.Tip="Layer opacity, set by the colour picker"/>
                                    <Button Grid.Column="4"
                                            Classes="compact"
                                            Content="Save"
                                            ToolTip.Tip="Save this layer as .la.json"
                                            Command="{Binding DataContext.SaveLayerCommand, ElementName=AnnotationManagerRoot}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Column="5"
                                            Classes="mini"
                                            Content="✕"
                                            ToolTip.Tip="Remove this layer"
                                            Command="{Binding DataContext.RemoveLayerCommand, ElementName=AnnotationManagerRoot}"
                                            CommandParameter="{Binding}"/>
                                </Grid>

                                <!--
                                    Annotations stay attached to their layer. The coloured spine keeps a
                                    long layer readable when several of them are expanded.
                                -->
                                <Border Grid.Row="2"
                                        BorderThickness="2,0,0,0"
                                        IsVisible="{Binding IsAnnotationsExpanded}"
                                        Margin="1,0,0,0"
                                        Padding="7,1,0,0">
                                    <Border.BorderBrush>
                                        <SolidColorBrush Color="{Binding Color}"/>
                                    </Border.BorderBrush>
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding Annotations}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:Annotation">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                                        <ToggleButton Grid.Column="0"
                                                                      Classes="mini"
                                                                      Content="◎"
                                                                      ToolTip.Tip="Highlight this annotation on the image"
                                                                      IsChecked="{Binding IsHighlighted, Mode=OneWay}"
                                                                      Command="{Binding DataContext.ToggleHighlightCommand, ElementName=AnnotationManagerRoot}"
                                                                      CommandParameter="{Binding}"/>
                                                        <TextBox Grid.Column="1"
                                                                 Classes="compact"
                                                                 Text="{Binding Label, Mode=TwoWay}"
                                                                 PlaceholderText="{Binding DisplayText}"
                                                                 ToolTip.Tip="{Binding DisplayText}"/>
                                                        <Button Grid.Column="2"
                                                                Classes="mini"
                                                                Content="✕"
                                                                ToolTip.Tip="Remove this annotation"
                                                                Command="{Binding DataContext.RemoveAnnotationCommand, ElementName=AnnotationManagerRoot}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="No annotations in this layer yet."
                                                   IsVisible="{Binding IsAnnotationsEmpty}"
                                                   FontSize="11"
                                                   Opacity="0.5"
                                                   Margin="0,2,0,2"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel IsVisible="{Binding HasNoLayers}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Margin="16">
                    <TextBlock Text="No annotation layers yet"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Add a layer, pick a tool, then click on a slice."
                               FontSize="11"
                               Opacity="0.6"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
