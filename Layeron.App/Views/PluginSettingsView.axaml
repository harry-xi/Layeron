<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Layeron.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="480"
             x:Class="Layeron.App.Views.PluginSettingsView"
             x:DataType="vm:PluginSettingsViewModel">
    <Design.DataContext>
        <vm:PluginSettingsViewModel/>
    </Design.DataContext>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding PluginCountText}" VerticalAlignment="Center" FontWeight="Bold"/>
            <Button Content="重载" Command="{Binding ReloadSelectedCommand}"/>
            <Button Content="卸载" Command="{Binding UnloadSelectedCommand}"/>
            <Button Content="位置" Command="{Binding ShowLocationCommand}"/>
            <Button Content="重扫目录" Command="{Binding RescanCommand}"/>
            <Button Content="泄漏自检" Command="{Binding VerifyUnloadCommand}"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Opacity="0.7" Margin="0,8,0,0"/>
        <Grid ColumnDefinitions="220,*" ColumnSpacing="8">
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Plugins}"
                     SelectedItem="{Binding SelectedPlugin, Mode=TwoWay}"
                     BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Descriptor.Name}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Id}" FontSize="11" Opacity="0.7"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Spacing="6">
                <TextBlock Text="未选择插件" IsVisible="{Binding HasNoSelection}" Opacity="0.5"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">
                    <TextBlock Text="{Binding SelectedPlugin.Descriptor.Name}" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedPlugin.Id}" Opacity="0.7"/>
                    <TextBlock Text="{Binding SelectedPlugin.Descriptor.Version, StringFormat='版本：{0}'}"/>
                    <TextBlock Text="{Binding SelectedPlugin.Descriptor.Description}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedPlugin.Location, StringFormat='位置：{0}'}" TextWrapping="Wrap" Opacity="0.7"/>
                    <TextBlock Text="工具面板" FontWeight="Bold" Margin="0,8,0,0"/>
                    <ItemsControl ItemsSource="{Binding SelectedPluginTools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
