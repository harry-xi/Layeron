<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Layeron.App.ViewModels"
             xmlns:local="using:Layeron.App.Views"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="220"
             x:Class="Layeron.App.Views.WindowLevelView"
             x:DataType="vm:WindowLevelViewModel">

    <Design.DataContext>
        <vm:WindowLevelViewModel/>
    </Design.DataContext>

    <Border Background="{DynamicResource LayeronCardBrush}"
            CornerRadius="8"
            Padding="12"
            Margin="8">
        <StackPanel Spacing="10">
            <local:GrayHistogramView Bins="{Binding Histogram}"
                                     Low="{Binding Low}"
                                     High="{Binding High}"
                                     ValueMax="{Binding HighMax}"/>

            <Grid ColumnDefinitions="64,*,64" ColumnSpacing="8">
                <TextBlock Text="灰度下界" VerticalAlignment="Center"/>
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding HighMax}"
                        Value="{Binding Low, Mode=TwoWay}"
                        VerticalAlignment="Center"/>
                <TextBox Grid.Column="2"
                         Width="64"
                         TextAlignment="Right"
                         VerticalAlignment="Center"
                         ToolTip.Tip="可直接输入，数值仍限制在灰度范围内"
                         Text="{Binding LowText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </Grid>

            <Grid ColumnDefinitions="64,*,64" ColumnSpacing="8">
                <TextBlock Text="灰度上界" VerticalAlignment="Center"/>
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding HighMax}"
                        Value="{Binding High, Mode=TwoWay}"
                        VerticalAlignment="Center"/>
                <TextBox Grid.Column="2"
                         Width="64"
                         TextAlignment="Right"
                         VerticalAlignment="Center"
                         ToolTip.Tip="可直接输入，数值仍限制在灰度范围内"
                         Text="{Binding HighText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
            </Grid>

            <Button Content="重置" Command="{Binding ResetCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
    </Border>
</UserControl>