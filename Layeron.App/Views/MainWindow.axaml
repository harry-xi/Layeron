<Window xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:Layeron.App.ViewModels"
            xmlns:controls="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:Class="Layeron.App.Views.MainWindow"
            x:DataType="vm:MainWindowViewModel"
            Icon="/Assets/avalonia-logo.ico"
            Title="Layeron.App - Dock Demo">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Header="加载数据" Command="{Binding SharedData.LoadCommand}"/>
                <MenuItem Header="保存数据" Command="{Binding SharedData.SaveCommand}"/>
                <MenuItem Header="生成演示数据" Command="{Binding SharedData.GenerateDemoCommand}"/>
                <MenuItem Header="从图片创建" Command="{Binding SharedData.CreateFromImagesCommand}"/>
            </MenuItem>
            <MenuItem Header="窗口">
                <MenuItem Header="XY 切片视图" Command="{Binding Dock.CreateSliceXYCommand}"/>
                <MenuItem Header="XZ 切片视图" Command="{Binding Dock.CreateSliceXZCommand}"/>
                <MenuItem Header="YZ 切片视图" Command="{Binding Dock.CreateSliceYZCommand}"/>
                <MenuItem Header="代码编辑器" Command="{Binding Dock.CreateCodeEditorCommand}"/>
            </MenuItem>
        </Menu>
        
        <controls:DockControl Layout="{Binding Dock.Layout}"/>
        
        <Border DockPanel.Dock="Bottom" Padding="10,4" Background="{DynamicResource SukiCardBackground}">
            <TextBlock Text="{Binding SharedData.StatusText}" VerticalAlignment="Center"/>
        </Border>
    </DockPanel>

</Window>
