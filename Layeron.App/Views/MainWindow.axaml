<Window xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:Layeron.App.ViewModels"
            xmlns:controls="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:Class="Layeron.App.Views.MainWindow"
            x:DataType="vm:MainWindowViewModel"
            Icon="/Assets/logo.ico"
            Title="Layeron">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <!-- Filled from code: the current workspace and ways to change it. -->
                <MenuItem x:Name="WorkspaceMenu" Header="工作区"/>
                <Separator/>
                <MenuItem Header="加载数据" Command="{Binding SharedData.LoadCommand}"/>
                <!-- Filled from code: the built-in readers plus every loader a plugin contributed. -->
                <MenuItem x:Name="ImportMenu" Header="从数据源加载"/>
                <MenuItem Header="保存数据" Command="{Binding SharedData.SaveCommand}"/>
                <Separator/>
                <MenuItem Header="生成演示数据" Command="{Binding SharedData.GenerateDemoCommand}"/>
                <MenuItem Header="生成16位演示数据" Command="{Binding SharedData.GenerateDemo16Command}"/>
                <Separator/>
                <MenuItem Header="从图片创建" Command="{Binding SharedData.CreateFromImagesCommand}"/>
            </MenuItem>
            <MenuItem Header="窗口">
                <MenuItem Header="轴位 (Axial) 视图" Command="{Binding Dock.CreateAxialCommand}"/>
                <MenuItem Header="冠状位 (Coronal) 视图" Command="{Binding Dock.CreateCoronalCommand}"/>
                <MenuItem Header="矢状位 (Sagittal) 视图" Command="{Binding Dock.CreateSagittalCommand}"/>
                <Separator/>
                <MenuItem Header="重置布局" Command="{Binding Dock.ResetLayoutCommand}"/>
                <MenuItem x:Name="SettingsMenuItem" Header="设置"/>

            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="遮罩管理器" Command="{Binding Dock.OpenMaskManagerCommand}"/>
                <MenuItem Header="标注管理器" Command="{Binding Dock.OpenAnnotationManagerCommand}"/>
                <MenuItem Header="窗宽窗位" Command="{Binding Dock.OpenWindowLevelCommand}"/>
                <MenuItem Header="日志" Command="{Binding Dock.OpenLogCommand}"/>
            </MenuItem>
            <MenuItem x:Name="PluginMenu" Header="插件"/>
        </Menu>
        
        <Border DockPanel.Dock="Bottom" Padding="10,4" Background="{DynamicResource SukiCardBackground}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding SharedData.StatusText}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Set from code: the workspace is the one piece of global context worth keeping visible. -->
                <TextBlock x:Name="WorkspaceText" Grid.Column="1" VerticalAlignment="Center"
                           Opacity="0.7" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
        
        <controls:DockControl Layout="{Binding Dock.Layout}"/>
    </DockPanel>

</Window>
