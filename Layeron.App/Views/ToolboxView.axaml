<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Layeron.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="520"
             x:Class="Layeron.App.Views.ToolboxView"
             x:DataType="vm:ToolboxViewModel">

    <ScrollViewer>
        <StackPanel Margin="8" Spacing="8">
            <TextBlock Text="工具箱" FontWeight="SemiBold"/>

            <ItemsControl ItemsSource="{Binding ToolGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolboxToolGroupViewModel">
                        <StackPanel Margin="0,2" Spacing="2">
                            <TextBlock Text="{Binding Header}"
                                       FontWeight="SemiBold"
                                       Opacity="0.72"
                                       IsVisible="{Binding HasHeader}"
                                       Margin="0,4,0,1"/>
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ToolboxToolViewModel">
                                        <Button Command="{Binding $parent[ItemsControl].((vm:ToolboxToolGroupViewModel)DataContext).SelectToolCommand}"
                                                CommandParameter="{Binding Id}"
                                                Margin="0,1"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Classes="tool">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}"/>
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="标注模式优先：切片左键正被标注工具占用，请先结束或取消标注。"
                       IsVisible="{Binding ShowAnnotationConflict}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="#FFFFB020"/>

            <Separator/>

            <CheckBox Content="擦除模式（取消则添加）" IsChecked="{Binding IsEraseMode, Mode=TwoWay}"/>

            <CheckBox Content="跨层自动连接（隔层提交时插值中间层）"
                      IsChecked="{Binding AutoConnectEnabled, Mode=TwoWay}"/>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2">
                <TextBlock Text="连接层距上限" VerticalAlignment="Center"/>
                <NumericUpDown Grid.Column="1"
                               Minimum="2"
                               Maximum="1024"
                               Increment="1"
                               Value="{Binding AutoConnectMaxGap, Mode=TwoWay}"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding Options.Count}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToolboxOptionViewModel">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,2">
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Column="1"
                                           IsVisible="{Binding IsNumber}"
                                           Minimum="{Binding Option.Min}"
                                           Maximum="{Binding Option.Max}"
                                           Increment="{Binding Option.Step}"
                                           Value="{Binding NumberValue, Mode=TwoWay}"/>
                            <CheckBox Grid.Column="1"
                                      IsVisible="{Binding IsToggle}"
                                      IsChecked="{Binding ToggleValue, Mode=TwoWay}"/>
                            <ComboBox Grid.Column="1"
                                      IsVisible="{Binding IsChoice}"
                                      ItemsSource="{Binding Choices}"
                                      SelectedIndex="{Binding ChoiceValue, Mode=TwoWay}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                <Button Content="撤销" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"/>
                <Button Grid.Column="1" Content="重做" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"/>
            </Grid>

            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.72" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
