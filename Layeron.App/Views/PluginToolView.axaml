<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:plugins="using:Layeron.App.Plugins"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="420"
             x:Class="Layeron.App.Views.PluginToolView"
             x:DataType="plugins:PluginToolViewModel">
    <!--
        Hosts the control a plugin produced. The host never names a plugin type: the content arrives as
        object and is rendered as-is, so a plugin's views stay inside the plugin's own load context.
    -->
    <ContentControl Content="{Binding Content}"/>
</UserControl>
