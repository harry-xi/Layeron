<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Layeron.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Layeron.App.Views.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel">
    <Design.DataContext>
        <vm:GeneralSettingsViewModel/>
    </Design.DataContext>
    <StackPanel Spacing="8" Margin="4">
        <TextBlock Text="常规" FontSize="16" FontWeight="Bold"/>
        <TextBlock Text="{Binding AppVersion, StringFormat='版本：{0}'}"/>

        <Border Background="{DynamicResource LayeronCardBrush}"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource LayeronCardCornerRadius}"
                Padding="12,8"
                Margin="0,4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="深色主题" FontWeight="SemiBold"/>
                    <TextBlock Text="关闭后切换到浅色主题，立即生效并在下次启动时保留。"
                               FontSize="11"
                               Opacity="0.7"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.7"/>
    </StackPanel>
</UserControl>
