<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Layeron.App.App"
             xmlns:local="using:Layeron.App"
             xmlns:plugins="using:Layeron.App.Plugins"
             xmlns:vm="using:Layeron.App.ViewModels"
             xmlns:views="using:Layeron.App.Views"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <!--
            Plugin panels are resolved explicitly and listed first: the type-name convention cannot map
            them (the content is plugin code), and the view locator below would otherwise claim the view
            model and render a "Not Found" placeholder.
        -->
        <DataTemplate DataType="plugins:PluginToolViewModel">
            <views:PluginToolView/>
        </DataTemplate>
        <DataTemplate DataType="plugins:PluginDocumentViewModel">
            <views:PluginDocumentView/>
        </DataTemplate>
        <!-- 设置窗口内置页与声明式页：显式映射，避免走类型名约定。 -->
        <DataTemplate DataType="vm:GeneralSettingsViewModel">
            <views:GeneralSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:PluginSettingsViewModel">
            <views:PluginSettingsView/>
        </DataTemplate>
        <DataTemplate DataType="vm:DeclaredSettingsPageViewModel">
            <views:DeclaredSettingsView/>
        </DataTemplate>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        
        <SimpleTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Simple/Simple.xaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml"/>
        <DockSimpleTheme/>
        
    </Application.Styles>
</Application>