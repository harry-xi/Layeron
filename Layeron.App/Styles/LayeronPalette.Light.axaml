<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Layeron 浅色调色板。

        这是普通 ResourceDictionary，而不是带 ThemeDictionaries 的文件：
        Avalonia 的 ResourceInclude 不会把被包含字典的 ThemeDictionaries 合并进父级，
        因此主题字典本身必须由 App.axaml 直接声明，内部再包含这份文件。
    -->

    <!-- Simple 基础色 -->
    <Color x:Key="ThemeBackgroundColor">#FFF4F6FA</Color>
    <Color x:Key="ThemeBorderLowColor">#FFE3E9F2</Color>
    <Color x:Key="ThemeBorderMidColor">#FFCFD9E6</Color>
    <Color x:Key="ThemeBorderHighColor">#FFAEBCCF</Color>
    <Color x:Key="ThemeControlLowColor">#FFFFFFFF</Color>
    <Color x:Key="ThemeControlMidColor">#FFF8FAFD</Color>
    <Color x:Key="ThemeControlMidHighColor">#FFD9E1EC</Color>
    <Color x:Key="ThemeControlHighColor">#FFE7EDF5</Color>
    <Color x:Key="ThemeControlVeryHighColor">#FF64748B</Color>
    <Color x:Key="ThemeControlHighlightLowColor">#FFF7F9FC</Color>
    <Color x:Key="ThemeControlHighlightMidColor">#FFEDF2F9</Color>
    <Color x:Key="ThemeControlHighlightHighColor">#FFE0E8F3</Color>
    <Color x:Key="ThemeForegroundColor">#FF18212F</Color>
    <Color x:Key="ThemeForegroundLowColor">#FF66748A</Color>
    <Color x:Key="HighlightColor">#FF2563EB</Color>
    <Color x:Key="HighlightColor2">#FF1D4ED8</Color>
    <Color x:Key="HighlightForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="HyperlinkVisitedColor">#FF7C3AED</Color>
    <Color x:Key="ErrorColor">#FFDC2626</Color>
    <Color x:Key="ErrorLowColor">#1ADC2626</Color>

    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource ThemeBackgroundColor}" />
    <SolidColorBrush x:Key="ThemeBorderLowBrush" Color="{StaticResource ThemeBorderLowColor}" />
    <SolidColorBrush x:Key="ThemeBorderMidBrush" Color="{StaticResource ThemeBorderMidColor}" />
    <SolidColorBrush x:Key="ThemeBorderHighBrush" Color="{StaticResource ThemeBorderHighColor}" />
    <SolidColorBrush x:Key="ThemeControlLowBrush" Color="{StaticResource ThemeControlLowColor}" />
    <SolidColorBrush x:Key="ThemeControlMidBrush" Color="{StaticResource ThemeControlMidColor}" />
    <SolidColorBrush x:Key="ThemeControlMidHighBrush" Color="{StaticResource ThemeControlMidHighColor}" />
    <SolidColorBrush x:Key="ThemeControlHighBrush" Color="{StaticResource ThemeControlHighColor}" />
    <SolidColorBrush x:Key="ThemeControlVeryHighBrush" Color="{StaticResource ThemeControlVeryHighColor}" />
    <SolidColorBrush x:Key="ThemeControlHighlightLowBrush" Color="{StaticResource ThemeControlHighlightLowColor}" />
    <SolidColorBrush x:Key="ThemeControlHighlightMidBrush" Color="{StaticResource ThemeControlHighlightMidColor}" />
    <SolidColorBrush x:Key="ThemeControlHighlightHighBrush" Color="{StaticResource ThemeControlHighlightHighColor}" />
    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="{StaticResource ThemeForegroundColor}" />
    <SolidColorBrush x:Key="ThemeForegroundLowBrush" Color="{StaticResource ThemeForegroundLowColor}" />
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="HighlightBrush2" Color="{StaticResource HighlightColor2}" />
    <SolidColorBrush x:Key="HighlightForegroundBrush" Color="{StaticResource HighlightForegroundColor}" />
    <SolidColorBrush x:Key="HyperlinkVisitedBrush" Color="{StaticResource HyperlinkVisitedColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorLowBrush" Color="{StaticResource ErrorLowColor}" />
    <SolidColorBrush x:Key="ThemeControlTransparentBrush" Color="Transparent" />

    <Color x:Key="ThemeAccentColor">#FF2563EB</Color>
    <Color x:Key="ThemeAccentColor2">#B32563EB</Color>
    <Color x:Key="ThemeAccentColor3">#662563EB</Color>
    <Color x:Key="ThemeAccentColor4">#332563EB</Color>
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource ThemeAccentColor}" />
    <SolidColorBrush x:Key="ThemeAccentBrush2" Color="{StaticResource ThemeAccentColor2}" />
    <SolidColorBrush x:Key="ThemeAccentBrush3" Color="{StaticResource ThemeAccentColor3}" />
    <SolidColorBrush x:Key="ThemeAccentBrush4" Color="{StaticResource ThemeAccentColor4}" />

    <!--
        Dock 拖放提示：边缘用实色强调，向面板内部渐隐。
        Dock 自身会把指示层再乘 0.5 透明度，所以这里的 Stop 比最终效果略强。
    -->
    <LinearGradientBrush x:Key="LayeronDockDropTopBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Offset="0" Color="{StaticResource ThemeAccentColor}" />
        <GradientStop Offset="0.08" Color="{StaticResource ThemeAccentColor2}" />
        <GradientStop Offset="0.35" Color="{StaticResource ThemeAccentColor3}" />
        <GradientStop Offset="1" Color="{StaticResource ThemeAccentColor4}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LayeronDockDropBottomBrush" StartPoint="0%,100%" EndPoint="0%,0%">
        <GradientStop Offset="0" Color="{StaticResource ThemeAccentColor}" />
        <GradientStop Offset="0.08" Color="{StaticResource ThemeAccentColor2}" />
        <GradientStop Offset="0.35" Color="{StaticResource ThemeAccentColor3}" />
        <GradientStop Offset="1" Color="{StaticResource ThemeAccentColor4}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LayeronDockDropLeftBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Offset="0" Color="{StaticResource ThemeAccentColor}" />
        <GradientStop Offset="0.08" Color="{StaticResource ThemeAccentColor2}" />
        <GradientStop Offset="0.35" Color="{StaticResource ThemeAccentColor3}" />
        <GradientStop Offset="1" Color="{StaticResource ThemeAccentColor4}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LayeronDockDropRightBrush" StartPoint="100%,0%" EndPoint="0%,0%">
        <GradientStop Offset="0" Color="{StaticResource ThemeAccentColor}" />
        <GradientStop Offset="0.08" Color="{StaticResource ThemeAccentColor2}" />
        <GradientStop Offset="0.35" Color="{StaticResource ThemeAccentColor3}" />
        <GradientStop Offset="1" Color="{StaticResource ThemeAccentColor4}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LayeronDockDropCenterBrush" Color="{StaticResource ThemeAccentColor3}" />

    <!--
        Dock 停靠选择器：默认是白色底 + 橙色箭头位图，这里替换成主题化的圆角卡片。
        每个方向画成“面板轮廓 + 该方向上的实心圆角矩形”：上/下/左/右是半块，居中是把
        整块填满。矩形直接预演拖动后会占用的区域，比只指出方向的箭头更直观；
        实心块使用与拖放提示相同的强调色，所以悬停哪一侧，哪一侧就亮起。
    -->
    <SolidColorBrush x:Key="LayeronDockSelectorWellBrush" Color="{StaticResource ThemeAccentColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="LayeronDockSelectorEdgeBrush" Color="{StaticResource ThemeAccentColor}" Opacity="0.55" />
    <RectangleGeometry x:Key="LayeronDockSelectorCardGeometry" Rect="5.5,5.5,29,29" RadiusX="6" RadiusY="6" />
    <RectangleGeometry x:Key="LayeronDockSelectorWellGeometry" Rect="11,11,18,18" RadiusX="3" RadiusY="3" />
    <RectangleGeometry x:Key="LayeronDockSelectorTopGlyphGeometry" Rect="11,11,18,9" RadiusX="3" RadiusY="3" />
    <RectangleGeometry x:Key="LayeronDockSelectorBottomGlyphGeometry" Rect="11,20,18,9" RadiusX="3" RadiusY="3" />
    <RectangleGeometry x:Key="LayeronDockSelectorLeftGlyphGeometry" Rect="11,11,9,18" RadiusX="3" RadiusY="3" />
    <RectangleGeometry x:Key="LayeronDockSelectorRightGlyphGeometry" Rect="20,11,9,18" RadiusX="3" RadiusY="3" />
    <RectangleGeometry x:Key="LayeronDockSelectorCenterGlyphGeometry" Rect="11,11,18,18" RadiusX="3" RadiusY="3" />

    <DrawingImage x:Key="LayeronDockSelectorTopImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V40 H0 Z" />
                <GeometryDrawing Brush="{StaticResource LayeronPopupBackgroundBrush}" Geometry="{StaticResource LayeronDockSelectorCardGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LayeronDockSelectorCardGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LayeronDockSelectorEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LayeronDockSelectorWellBrush}" Geometry="{StaticResource LayeronDockSelectorWellGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LayeronDockSelectorWellGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LayeronDockSelectorEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LayeronAccentBrush}" Geometry="{StaticResource LayeronDockSelectorTopGlyphGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="LayeronDockSelectorBottomImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V40 H0 Z" />
                <GeometryDrawing Brush="{StaticResource LayeronPopupBackgroundBrush}" Geometry="{StaticResource LayeronDockSelectorCardGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LayeronDockSelectorCardGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LayeronDockSelectorEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LayeronDockSelectorWellBrush}" Geometry="{StaticResource LayeronDockSelectorWellGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LayeronDockSelectorWellGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LayeronDockSelectorEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LayeronAccentBrush}" Geometry="{StaticResource LayeronDockSelectorBottomGlyphGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="LayeronDockSelectorLeftImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V40 H0 Z" />
                <GeometryDrawing Brush="{StaticResource LayeronPopupBackgroundBrush}" Geometry="{StaticResource LayeronDockSelectorCardGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LayeronDockSelectorCardGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LayeronDockSelectorEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LayeronDockSelectorWellBrush}" Geometry="{StaticResource LayeronDockSelectorWellGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LayeronDockSelectorWellGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LayeronDockSelectorEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LayeronAccentBrush}" Geometry="{StaticResource LayeronDockSelectorLeftGlyphGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="LayeronDockSelectorRightImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V40 H0 Z" />
                <GeometryDrawing Brush="{StaticResource LayeronPopupBackgroundBrush}" Geometry="{StaticResource LayeronDockSelectorCardGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LayeronDockSelectorCardGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LayeronDockSelectorEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LayeronDockSelectorWellBrush}" Geometry="{StaticResource LayeronDockSelectorWellGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LayeronDockSelectorWellGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LayeronDockSelectorEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LayeronAccentBrush}" Geometry="{StaticResource LayeronDockSelectorRightGlyphGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="LayeronDockSelectorCenterImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent" Geometry="M0,0 H40 V40 H0 Z" />
                <GeometryDrawing Brush="{StaticResource LayeronPopupBackgroundBrush}" Geometry="{StaticResource LayeronDockSelectorCardGeometry}" />
                <GeometryDrawing Geometry="{StaticResource LayeronDockSelectorCardGeometry}">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource LayeronDockSelectorEdgeBrush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LayeronAccentBrush}" Geometry="{StaticResource LayeronDockSelectorCenterGlyphGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- 窗口标题栏 / 通知（Simple 依赖这些键） -->
    <SolidColorBrush x:Key="CaptionButtonForeground" Color="#FF18212F" />
    <SolidColorBrush x:Key="CaptionButtonBackground" Color="#FFF8FAFD" />
    <SolidColorBrush x:Key="CaptionButtonBorderBrush" Color="#FFE3E9F2" />
    <StaticResource x:Key="TitleBarBackgroundBrush" ResourceKey="ThemeBackgroundBrush" />
    <SolidColorBrush x:Key="RefreshVisualizerForeground" Color="#FF18212F" />
    <SolidColorBrush x:Key="RefreshVisualizerBackground" Color="Transparent" />
    <SolidColorBrush x:Key="NotificationCardBackgroundBrush" Opacity="0.92" Color="#FF1F2937" />
    <SolidColorBrush x:Key="NotificationCardInformationBackgroundBrush" Opacity="0.92" Color="#FF2563EB" />
    <SolidColorBrush x:Key="NotificationCardSuccessBackgroundBrush" Opacity="0.92" Color="#FF059669" />
    <SolidColorBrush x:Key="NotificationCardWarningBackgroundBrush" Opacity="0.92" Color="#FFD97706" />
    <SolidColorBrush x:Key="NotificationCardErrorBackgroundBrush" Opacity="0.92" Color="#FFDC2626" />
    <SolidColorBrush x:Key="DatePickerFlyoutPresenterHighlightFill" Opacity="0.4" Color="{StaticResource ThemeAccentColor}" />
    <SolidColorBrush x:Key="TimePickerFlyoutPresenterHighlightFill" Opacity="0.4" Color="{StaticResource ThemeAccentColor}" />

    <!-- Layeron 语义色 -->
    <Color x:Key="LayeronAccentColor">#FF2563EB</Color>
    <SolidColorBrush x:Key="LayeronAccentBrush" Color="{StaticResource LayeronAccentColor}" />
    <SolidColorBrush x:Key="LayeronAccentHoverBrush" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="LayeronAccentPressedBrush" Color="#FF1E40AF" />
    <SolidColorBrush x:Key="LayeronAccentTextBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LayeronAccentSubtleBrush" Color="#1F2563EB" />
    <SolidColorBrush x:Key="LayeronSelectionBrush" Color="#332563EB" />
    <SolidColorBrush x:Key="LayeronFocusBrush" Color="#992563EB" />
    <SolidColorBrush x:Key="LayeronSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LayeronSurfaceRaisedBrush" Color="#FFF7F9FC" />
    <SolidColorBrush x:Key="LayeronSurfaceSunkenBrush" Color="#FFEDF1F7" />
    <SolidColorBrush x:Key="LayeronCardBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LayeronCardBorderBrush" Color="#FFDDE4EE" />
    <SolidColorBrush x:Key="LayeronHoverBrush" Color="#FFEDF2F9" />
    <SolidColorBrush x:Key="LayeronPopupBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LayeronTooltipBackgroundBrush" Color="#FF1F2937" />
    <SolidColorBrush x:Key="LayeronTooltipForegroundBrush" Color="#FFF9FAFB" />
    <SolidColorBrush x:Key="LayeronDangerBrush" Color="#FFDC2626" />
    <SolidColorBrush x:Key="LayeronWarningBrush" Color="#FFD97706" />
    <SolidColorBrush x:Key="LayeronSuccessBrush" Color="#FF059669" />
    <SolidColorBrush x:Key="LayeronEditorBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="LayeronBackdropBrush" Color="#66000000" />
    <Color x:Key="LayeronBackdropColor">#66000000</Color>
    <Color x:Key="LayeronPopupBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="LayeronDockDocumentBorderColor">#FFCBD6E4</Color>
    <SolidColorBrush x:Key="LayeronDockDocumentBorderBrush" Color="{StaticResource LayeronDockDocumentBorderColor}" />
    <Color x:Key="LayeronDockTabStripColor">#FFF0F4FA</Color>
    <Color x:Key="LayeronDockTabActiveColor">#FFFFFFFF</Color>
    <Color x:Key="LayeronDockTabHoverColor">#FFF7F9FC</Color>
</ResourceDictionary>
