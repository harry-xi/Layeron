<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!-- <OutputType>Exe</OutputType> -->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <SixLaborsLicenseFile>$(SIXLABORS_LICENSE_FILE)</SixLaborsLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
        <Folder Include="Service\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
        <PackageReference Include="Dock.Avalonia" Version="12.1.0.6" />
        <PackageReference Include="Dock.Avalonia.Themes.Simple" Version="12.1.0.6" />
        <PackageReference Include="Dock.Model.ReactiveUI" Version="12.1.0.6" />
        <PackageReference Include="Dock.Serializer.SystemTextJson" Version="12.1.0.6" />
        <PackageReference Include="fo-dicom" Version="5.2.6" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />

    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Layeron.Big3DArray\Layeron.Big3DArray.csproj" />
        <ProjectReference Include="..\Layeron.Plugin.Abstractions\Layeron.Plugin.Abstractions.csproj" />
        <ProjectReference Include="..\Layeron.Plugin.Host\Layeron.Plugin.Host.csproj" />
        <!--
          The scripting layer: the app implements IScriptHostService and must have the assembly in its
          default context, which is also where Roslyn loads compiled scripts. See design-notes/PLUGIN_SYSTEM.md §10.
        -->
        <ProjectReference Include="..\Layeron.Scripting.Abstractions\Layeron.Scripting.Abstractions.csproj" />
        <!--
          The sample plugins are built with the app and deployed into a development plugin folder
          (see DeploySamplePlugins) so a plain build yields a working plugin set. They are not
          referenced as assemblies: the app must never compile against plugin code.
        -->
        <ProjectReference Include="..\Layeron.Plugins.ScriptHost\Layeron.Plugins.ScriptHost.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Layeron.Plugins.Threshold\Layeron.Plugins.Threshold.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Layeron.Plugins.Filters\Layeron.Plugins.Filters.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Layeron.Plugins.Model3D\Layeron.Plugins.Model3D.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Layeron.Plugins.PythonRunner\Layeron.Plugins.PythonRunner.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Layeron.Plugins.Agent\Layeron.Plugins.Agent.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Layeron.Plugins.OnnxRuntime\Layeron.Plugins.OnnxRuntime.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\DeclaredSettingsView.axaml.cs">
        <DependentUpon>DeclaredSettingsView.axaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <!--
      Copies each sample plugin into $(OutDir)plugins.dev/<plugin id>/. The manager scans that folder
      before the installed one, so a locally built plugin shadows an installed copy with the same id.
      The whole plugin output is copied because a plugin may ship private dependencies (Roslyn, for the
      script host) that its own load context resolves from its folder and .deps.json.

      $(RuntimeIdentifier) is part of the source path so a RID-specific build (for example
      `-r win-x64`) deploys the plugin's RID-specific output. Without it the plugins would still be
      copied from a RID-less folder and drag every platform's native assets into the packaged app.
      It is empty for an ordinary build, where the path stays bin/<Configuration>/net10.0/.
    -->
    <Target Name="DeploySamplePlugins" AfterTargets="Build">
        <ItemGroup>
            <SamplePluginFile Include="..\Layeron.Plugins.Threshold\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*.*">
                <PluginFolder>layeron.threshold</PluginFolder>
            </SamplePluginFile>
            <SamplePluginFile Include="..\Layeron.Plugins.Filters\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*.*">
                <PluginFolder>layeron.filters</PluginFolder>
            </SamplePluginFile>
            <SamplePluginFile Include="..\Layeron.Plugins.ScriptHost\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*.*">
                <PluginFolder>layeron.scripthost</PluginFolder>
            </SamplePluginFile>
            <SamplePluginFile Include="..\Layeron.Plugins.Model3D\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*.*">
                <PluginFolder>layeron.model3d</PluginFolder>
            </SamplePluginFile>
            <SamplePluginFile Include="..\Layeron.Plugins.PythonRunner\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*.*">
                <PluginFolder>layeron.pythonrunner</PluginFolder>
            </SamplePluginFile>
            <SamplePluginFile Include="..\Layeron.Plugins.Agent\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*.*">
                <PluginFolder>layeron.agent</PluginFolder>
            </SamplePluginFile>
            <SamplePluginFile Include="..\Layeron.Plugins.OnnxRuntime\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*.*">
                <PluginFolder>layeron.onnxruntime</PluginFolder>
            </SamplePluginFile>
        </ItemGroup>

        <Copy SourceFiles="@(SamplePluginFile)" DestinationFiles="@(SamplePluginFile->'$(OutDir)plugins.dev\%(PluginFolder)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <!--
      Copies the plugin-to-plugin contracts into $(OutDir)plugins.shared/. The plugin manager loads that
      whole folder into one load context (PluginSharedAssemblies) and every plugin resolves those names
      from it, which is what makes a type defined by one plugin the same type in another. A contract must
      therefore NOT sit in a plugin's own folder: that copy would be a second, incompatible type.

      Projects that publish a contract are the ones that reference it with Private="false"; the copy here
      is the single deployment of it.
    -->
    <Target Name="DeploySharedContracts" AfterTargets="Build">
        <ItemGroup>
            <SharedContractFile Include="..\Layeron.Plugins.PythonRunner.Api\bin\$(Configuration)\net10.0\Layeron.Plugins.PythonRunner.Api.*" />
            <SharedContractFile Include="..\Layeron.Plugins.Onnx.Api\bin\$(Configuration)\net10.0\Layeron.Plugins.Onnx.Api.*" />
        </ItemGroup>

        <Copy SourceFiles="@(SharedContractFile)"
              DestinationFolder="$(OutDir)plugins.shared"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
