<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <SixLaborsLicenseFile>$(SIXLABORS_LICENSE_FILE)</SixLaborsLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
        <Folder Include="Service\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
        <PackageReference Include="Dock.Avalonia" Version="12.1.0.6" />
        <PackageReference Include="Dock.Avalonia.Themes.Simple" Version="12.1.0.6" />
        <PackageReference Include="Dock.Model.ReactiveUI" Version="12.1.0.6" />
        <PackageReference Include="Dock.Serializer.SystemTextJson" Version="12.1.0.6" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="4.1.2" />

    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Layeron.Big3DArray\Layeron.Big3DArray.csproj" />
        <ProjectReference Include="..\Layeron.Plugin.Abstractions\Layeron.Plugin.Abstractions.csproj" />
        <ProjectReference Include="..\Layeron.Plugin.Host\Layeron.Plugin.Host.csproj" />
        <!--
          The sample plugins are built with the app and deployed into a development plugin folder
          (see DeploySamplePlugins) so a plain build yields a working plugin set. They are not
          referenced as assemblies: the app must never compile against plugin code.
        -->
        <ProjectReference Include="..\Layeron.Plugins.ScriptHost\Layeron.Plugins.ScriptHost.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Layeron.Plugins.Threshold\Layeron.Plugins.Threshold.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Views\DeclaredSettingsView.axaml.cs">
        <DependentUpon>DeclaredSettingsView.axaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <!--
      Copies each sample plugin into $(OutDir)plugins.dev/<plugin id>/. The manager scans that folder
      before the installed one, so a locally built plugin shadows an installed copy with the same id.
      The whole plugin output is copied because a plugin may ship private dependencies (Roslyn, for the
      script host) that its own load context resolves from its folder and .deps.json.
    -->
    <Target Name="DeploySamplePlugins" AfterTargets="Build">
        <ItemGroup>
            <SamplePluginFile Include="..\Layeron.Plugins.Threshold\bin\$(Configuration)\net10.0\**\*.*">
                <PluginFolder>layeron.threshold</PluginFolder>
            </SamplePluginFile>
            <SamplePluginFile Include="..\Layeron.Plugins.ScriptHost\bin\$(Configuration)\net10.0\**\*.*">
                <PluginFolder>layeron.scripthost</PluginFolder>
            </SamplePluginFile>
        </ItemGroup>

        <Copy SourceFiles="@(SamplePluginFile)" DestinationFiles="@(SamplePluginFile->'$(OutDir)plugins.dev\%(PluginFolder)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
    
</Project>
