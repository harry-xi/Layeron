<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      Native and framework-dependent assets must follow the host's RID. Without this a RID-specific
      build (for example -r win-x64) still deploys this plugin's every-platform untimes folder,
      which is what made the Windows package carry macOS/Linux Skia binaries and PDBs.
    -->
    <IsRidAgnostic>false</IsRidAgnostic>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Layeron.Plugins.Threshold</AssemblyName>
    <!-- Avalonia XAML: enable compiled XAML for the plugin's own views.
         The Avalonia package itself (compile assets) is needed to build the
         XAML; only the runtime assets are excluded so the host's copy wins. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Plugin identity is emitted as assembly metadata, so the host can read id/version/API version
    with MetadataLoadContext without loading (or running) the plugin. There is deliberately no
    manifest.json for a .NET plugin: the metadata is already in the assembly.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="LayeronPluginId" Value="layeron.threshold" />
    <AssemblyMetadata Include="LayeronPluginName" Value="Threshold Segmentation" />
    <AssemblyMetadata Include="LayeronPluginVersion" Value="1.0.0" />
    <AssemblyMetadata Include="LayeronPluginDescription" Value="Interactive threshold segmentation producing mask layers." />
    <AssemblyMetadata Include="LayeronPluginApiVersion" Value="1.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Contracts are compile-time only: the host's copies must be used at runtime, otherwise the
      plugin would see a second IPlugin type. This also keeps the plugin folder free of copies of
      the host stack.
    -->
    <ProjectReference Include="..\Layeron.Big3DArray\Layeron.Big3DArray.csproj" Private="false" />
    <ProjectReference Include="..\Layeron.Plugin.Abstractions\Layeron.Plugin.Abstractions.csproj" Private="false" />

    <!-- UI plugins declare views in XAML against the host's Avalonia; runtime assets are excluded. -->
    <PackageReference Include="Avalonia" Version="12.1.3" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <!-- Same MVVM stack as the host App (ReactiveUI): shared at runtime via PluginLoadContext
         (the App carries it, so plugins bind to that one copy), so the plugin never ships its own
         copy. Version must match Layeron.App. -->
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
