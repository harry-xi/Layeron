<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Layeron.Plugins.Threshold"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="480"
             x:Class="Layeron.Plugins.Threshold.ThresholdToolView"
             x:DataType="local:ThresholdToolViewModel">

  <Design.DataContext>
    <local:ThresholdToolViewModel />
  </Design.DataContext>

  <StackPanel Spacing="8" Margin="8">
    <TextBlock Text="阈值分割" FontWeight="SemiBold" />

    <local:HistogramView MinHeight="72"
                         Bins="{Binding HistogramBins}"
                         SelectionStart="{Binding SelectionStart}"
                         SelectionEnd="{Binding SelectionEnd}" />

    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Text="下限" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Width="130" VerticalAlignment="Center"
              Minimum="0" Maximum="{Binding Maximum}"
              Value="{Binding Low, Mode=TwoWay}" />
      <TextBlock Grid.Column="2" Text="{Binding LowText}"
                 VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" />
    </Grid>

    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Text="上限" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Width="130" VerticalAlignment="Center"
              Minimum="0" Maximum="{Binding Maximum}"
              Value="{Binding High, Mode=TwoWay}" />
      <TextBlock Grid.Column="2" Text="{Binding HighText}"
                 VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" />
    </Grid>

    <CheckBox Content="预览" IsChecked="{Binding PreviewEnabled, Mode=TwoWay}" />

    <StackPanel Orientation="Horizontal" Spacing="6">
      <Button Content="应用" Command="{Binding ApplyCommand}" />
      <Button Content="取消" Command="{Binding CancelCommand}" />
    </StackPanel>

    <ProgressBar Value="{Binding ProgressValue}" Minimum="0" Maximum="100" />
    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />

    <TextBlock Text="扩展" FontSize="11" Opacity="0.7"
               IsVisible="{Binding HasQuickActions}" />
    <ItemsControl ItemsSource="{Binding QuickActions}"
                  IsVisible="{Binding HasQuickActions}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="6" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="local:ThresholdToolViewModel+QuickActionItem">
          <Button Content="{Binding Header}"
                  ToolTip.Tip="{Binding Tooltip}"
                  Command="{Binding ExecuteCommand}"
                  FontSize="11" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>

